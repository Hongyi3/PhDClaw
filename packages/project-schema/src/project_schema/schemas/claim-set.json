{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawbio.org/schemas/project-schema/claim-set-1.5.0.json",
  "title": "ClawBio Scholar Claim Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "citations",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.5.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": true
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "analysis_runs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
