{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawbio.org/schemas/project-schema/claim-set-1.0.0.json",
  "title": "ClawBio Scholar Claim Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "citations",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
