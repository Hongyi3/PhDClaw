{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawbio.org/schemas/project-schema/citation-1.0.0.json",
  "title": "ClawBio Scholar Citation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "issued_year",
    "authors",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "journal-article",
        "preprint",
        "book",
        "book-chapter",
        "conference-paper",
        "dataset",
        "software",
        "webpage"
      ]
    },
    "issued_year": {
      "type": "integer",
      "minimum": 1600,
      "maximum": 2100
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_name",
          "given_name"
        ],
        "properties": {
          "family_name": {
            "type": "string",
            "minLength": 1
          },
          "given_name": {
            "type": "string",
            "minLength": 1
          },
          "orcid": {
            "type": "string",
            "pattern": "^https://orcid\\.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
          }
        }
      }
    },
    "doi": {
      "type": "string",
      "pattern": "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$"
    },
    "pmid": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "pmcid": {
      "type": "string",
      "pattern": "^PMC[0-9]+$"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "crossref",
            "pubmed",
            "manual-verified"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "access_url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "doi"
      ]
    },
    {
      "required": [
        "pmid"
      ]
    },
    {
      "required": [
        "pmcid"
      ]
    }
  ]
}
