{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawbio.org/schemas/project-schema/reproducibility-bundle-1.5.0.json",
  "title": "ClawBio Scholar Reproducibility Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "analysis_runs",
    "figures"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.5.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": true
    },
    "analysis_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
