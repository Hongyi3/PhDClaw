{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawbio.org/schemas/project-schema/claim-1.5.0.json",
  "title": "ClawBio Scholar Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "text"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "citation_support": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "citation_id",
          "role"
        ],
        "properties": {
          "citation_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "background",
              "protocol"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "analysis_run_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "citation_support"
      ]
    },
    {
      "required": [
        "analysis_run_ids"
      ]
    }
  ]
}
