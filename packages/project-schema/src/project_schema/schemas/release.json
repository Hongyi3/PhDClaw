{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawbio.org/schemas/project-schema/release-1.4.0.json",
  "title": "ClawBio Scholar Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project_id",
    "title",
    "version",
    "status",
    "created_at",
    "citation",
    "reproducibility_bundle_artifact_ids",
    "artifacts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "published"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "citation": {
      "$ref": "#/$defs/citation"
    },
    "reproducibility_bundle_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "archive": {
      "$ref": "#/$defs/archive"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        }
      },
      "then": {
        "required": [
          "released_at",
          "archive"
        ]
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cff_artifact_id",
        "codemeta_artifact_id"
      ],
      "properties": {
        "cff_artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "codemeta_artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "version_identifier",
        "landing_page_url",
        "archived_at"
      ],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "version_identifier": {
          "type": "string",
          "minLength": 1
        },
        "landing_page_url": {
          "type": "string",
          "format": "uri"
        },
        "archived_at": {
          "type": "string",
          "format": "date-time"
        },
        "concept_identifier": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
